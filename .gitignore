/android/app/release

# بروفايلات المتصفّح اللي تشغّلها سكربتات فيغما — بيها كوكيز و«Login Data»،
# وممنوع تطلع بريبو عام. تنولد من جديد بأول تشغيل.
.figma2/_chromeprof/
.figma2/_navprof/
.figma2/_pngprof/
.figma2/_rastprof/
.figma2/_prevprof/

# نسخ احتياطية ثقيلة لتفريغ فيغما — الأصل design.json يكفي
.figma/*.bak.json
.figma2/*.bak.json

